# Copie para .env somente se ele ainda nao existir. Nunca versione credenciais.
# Obrigatorio para iniciar o bot e registrar comandos:
TOKEN=SUBSTITUA_PELO_TOKEN_DO_BOT
# Obrigatorio para o registro global; use o Application ID da mesma aplicacao:
CLIENT_ID=SUBSTITUA_PELO_APPLICATION_ID
# Opcional: vazio usa o convite publico fixo implementado em commands/invite.js.
# Configure a URL OAuth da sua aplicacao se estiver recuperando uma instancia propria.
INVITE_URL=
# Opcional: valor publico equivalente ao fallback do codigo.
LOFIRADIO_URL=https://lofiradio.web.app
