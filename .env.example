# Copie para .env somente se ele ainda nao existir. Nunca versione credenciais.
# Obrigatorio para iniciar o bot e registrar comandos:
TOKEN=SUBSTITUA_PELO_TOKEN_DO_BOT
# Opcional no runtime; obrigatorio para registro global autorizado.
# Use o Application ID da mesma aplicacao do TOKEN; nao e o ID de uma pagina top.gg.
# Vazio permite /invite derivar a identidade da propria interacao Discord.
CLIENT_ID=
# Opcional: vazio gera o convite da aplicacao atual com permissions=117824.
# Se preenchido, aceite somente authorize em https://discord.com, com client_id
# coerente, permissions=117824 e scope=bot%20applications.commands; sem extras.
INVITE_URL=
# Opcional: HTTPS publico sem credenciais, query ou fragmento (ate 512 caracteres).
# Vazio usa o mesmo endereco publico abaixo; disponibilidade externa nao garantida.
LOFIRADIO_URL=https://lofiradio.web.app
